{
  "manifest_version": 3,
  "name": "ONE voice (ChatGPT)",
  "version": "0.6.1",
  "description": "Hotkey voice-to-text via ChatGPT dictation. Plain: your words to the clipboard. Grammar: your @grammar GPT's whole answer to the clipboard.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "alarms",
    "offscreen",
    "clipboardWrite",
    "notifications"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "optional_host_permissions": [
    "*://*.youtube.com/*",
    "*://*.spotify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "1-plain": {
      "suggested_key": {
        "default": "Ctrl+Shift+1"
      },
      "description": "Plain: start / stop dictation, your words to clipboard"
    },
    "2-grammar": {
      "suggested_key": {
        "default": "Ctrl+Shift+2"
      },
      "description": "Grammar: start / stop dictation, the GPT's whole answer to clipboard"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "ONE voice (ChatGPT)",
    "default_popup": "options.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
